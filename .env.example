# BuildMate 统一环境配置模板
# 复制为 .env 后按需填写。密钥仅放 .env 或部署平台的环境变量，禁止提交。

# ============ 应用 ============
APP_ENV=local
APP_DEBUG=true
LOG_LEVEL=INFO
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=buildmate-backend
DEFAULT_TENANT_ID=tenant_default
# 多个来源以英文逗号分隔；留空时仅允许本机前端来源。
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ============ LLM（留空即离线 Mock 模式） ============
LLM_API_KEY=
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=deepseek-ai/DeepSeek-V3
LLM_TEMPERATURE=0.1
# LLM_PROVIDER=                 # 空/auto 自动选择；仅在注册自定义 Provider 时设置。

# ============ 嵌入与本地模型 ============
# 两项留空时使用本地哈希向量；也可填写 OpenAI 兼容 Embedding 服务。
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
# 本机默认 models；Docker Compose 中为 /models。
MODELS_ROOT=models
# 大型本地 BGE/CrossEncoder 模型默认关闭，避免首次对话加载数 GB 权重。
# 需要离线高质量向量/重排时再显式打开，并确认模型文件完整。
RAG_LOCAL_MODELS_ENABLED=false
RAG_RERANKER_ENABLED=false

# ============ 数据库与向量检索 ============
DATABASE_URL=sqlite+aiosqlite:///./data/runtime/db/buildmate.db
# 生产可将迁移连接与受 RLS 限制的业务连接分离。
MIGRATION_DATABASE_URL=
# 生产示例：DATABASE_URL=postgresql+asyncpg://buildmate:<strong-password>@postgres:5432/buildmate
MILVUS_HOST=
MILVUS_PORT=19531
# 无嵌入服务/本地模型时使用 local；配置匹配的嵌入模型后再启用 milvus。
VECTOR_BACKEND=local
# 多实例时必须配置 Redis，供限流与令牌吊销状态共享。
REDIS_URL=

# 本地默认数据库 Runner；生产设 rabbitmq，并单独启动 outbox publisher/worker。
TASK_QUEUE_BACKEND=local
TASK_RUNNER_POLL_SECONDS=0.5
WALL_PIPELINE_PREPARE_TIMEOUT_SECONDS=1200
# Revit delivery includes Bridge write, read-back, artifact persistence and
# independent overlay audit; keep it separate from ordinary Agent timeouts.
WALL_PIPELINE_REVIT_WRITE_TIMEOUT_SECONDS=900
RABBITMQ_URL=
RABBITMQ_EXCHANGE=buildmate.tasks

# 制品存储：本地 local；生产可切 s3 指向 MinIO/S3。
ARTIFACT_STORAGE_BACKEND=local
ARTIFACT_STORAGE_ROOT=data/uploads_v2
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=buildmate-artifacts
S3_REGION=us-east-1
S3_CACHE_ROOT=data/runtime/s3-cache

# ============ 安全与编排 ============
# 生产环境必须替换为随机值：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_STRONG_RANDOM_AT_LEAST_32_CHARS
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
BCRYPT_ROUNDS=12
MCP_DEFAULT_TIMEOUT=30
MCP_AUTH_TOKEN=
MCP_TOOL_ACL=
# 本地默认端口；生产部署请使用可达的服务地址。
MCP_WEB_SEARCH_URL=http://127.0.0.1:8002
MCP_IFC_PARSER_URL=http://127.0.0.1:8003
MCP_DRAWING_PERCEPTION_URL=http://127.0.0.1:8004
ORCHESTRATOR_TASK_TIMEOUT=120
BREAKER_FAILURE_THRESHOLD=5
BREAKER_COOLDOWN_SECONDS=30

# ============ 文档与 BIM ============
BIM_MAX_UPLOAD_MB=200
OCR_ENABLED=1
OCR_USE_GPU=0
# 留空时自动使用 data/runtime/wall_pipeline/.ocr-cache；同一源文件重复任务可复用 OCR 结果。
WALL_PIPELINE_OCR_CACHE_DIR=
# 留空时自动使用 data/runtime/wall_pipeline/.source-cache；复用完整的
# PDF/DWG SourceEntities 解析结果。只缓存确定性解析，不缓存审批或 Revit 写入。
WALL_PIPELINE_SOURCE_CACHE_DIR=
# 仅上传 DWG 时需要；上传 DXF 无需设置。
ODA_FILE_CONVERTER=

# 可选的全图墙清洗复核。YOLO 只提供语义证据，实际建模坐标仍取自 DXF。
DRAWING_FULL_CV_AUDIT=1
DRAWING_YOLO_MODEL_PATH=
DRAWING_YOLO_REQUIRED=0
DRAWING_YOLO_CONFIDENCE=0.10
DRAWING_YOLO_TILE_SIZE=896
DRAWING_YOLO_TILE_OVERLAP=224
# 留空时按源 DXF 文件名单独保存，避免不同图纸复用同一份审计结果。
DRAWING_CLEANING_AUDIT_DIR=

# 后端默认使用项目内 data/runtime/revit。Docker 通过共享卷自动使用容器路径。
# 若 Revit 在 Windows 宿主机运行，请填写该宿主机上的绝对路径，并把这两个变量
# 配置为 Revit 进程的系统环境变量后重启 Revit；.env 不会自动注入已启动的 Revit。
BIM_JSON_IN=
REVIT_OUTPUT_DIR=
# Optional source checkout root used by pyRevit scripts when the two paths above are empty.
BUILDMATE_PROJECT_ROOT=
PYREVIT_JSON2RVT_SCRIPT=
REVIT_MCP_PYTHON=
# 默认为 workers/revit_mcp/main.py，无需填写。
REVIT_MCP_MAIN=
# 独立 Windows Bridge 默认仅允许静态校验和 Dry-run。执行时必须显式开启并配置审批密钥。
REVIT_BRIDGE_URL=http://127.0.0.1:8005
# Revit transaction + independent plan render can exceed 90s on large sheets.
REVIT_BRIDGE_TIMEOUT_SECONDS=900
REVIT_BRIDGE_EXECUTION_ENABLED=false
# Legacy arbitrary live scripts remain disabled unless explicitly enabled.
REVIT_BRIDGE_LEGACY_SCRIPT_EXECUTION_ENABLED=false
REVIT_BRIDGE_APPROVAL_SECRET=
REVIT_BRIDGE_WORK_ROOT=data/runtime/revit/bridge
# Production: restrict source/target RVT files to this dedicated shared root.
# Leave empty only for local fixture/demo mode.
REVIT_TARGET_ROOT=
# 可选：仅调试脚本需要。
BIM_REVIT_DEBUG_LOG=
REVIT_MODEL_PATH=
# scripts/revit_transient_wall_preview.py 手工预览输入；主 wall_pipeline 不读取这些值。
BUILDMATE_PREVIEW_ARCH_MODEL=
BUILDMATE_PREVIEW_ARCH_GRID=
BUILDMATE_PREVIEW_STRUCT_MODEL=
BUILDMATE_PREVIEW_STRUCT_GRID=
BUILDMATE_PREVIEW_PDF_WALL=
