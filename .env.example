# BuildMate Demo 环境变量（复制为 .env 后填写）
# ============ LLM（硅基流动 / DeepSeek 兼容 OpenAI API） ============
# 留空则进入 Mock 模式：不调真实 LLM，用本地规则+模板回复跑通全链路
LLM_API_KEY=
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=deepseek-ai/DeepSeek-V3
LLM_TEMPERATURE=0.1

# ============ 嵌入（RAG 用；留空则用本地字符哈希向量，离线可跑） ============
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3

# ============ 数据库（默认 SQLite，零依赖；生产切 PostgreSQL 改这里） ============
# 生产：DATABASE_URL=postgresql+asyncpg://eduagent_user:eduagent123456@127.0.0.1:5433/buildmate
DATABASE_URL=sqlite+aiosqlite:///./buildmate.db

# ============ Milvus 向量库（可选：配置 host 且 Docker 启动后启用，否则回退本地向量） ============
MILVUS_HOST=
MILVUS_PORT=19531

# ============ 本地模型根目录（BGE-M3/Reranker/分类器） ============
# 本机默认：D:\新建文件夹 (2)\models
# 容器内挂载：MODELS_ROOT=/models（docker run -v "D:\新建文件夹 (2)\models:/models"）
MODELS_ROOT=

# ============ 安全 ============
# 必填：强随机密钥（生产环境用环境变量注入，勿提交真实值）
# 生成：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_STRONG_RANDOM_AT_LEAST_32_CHARS
# H4：访问令牌短效 + 刷新令牌长效（旧 JWT_EXPIRE_MINUTES 兼容保留）
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
# bcrypt 成本（测试可调低加速，如 BCRYPT_ROUNDS=4）
BCRYPT_ROUNDS=12

# 企业化：多实例共享限流/吊销状态（空 = 进程内存回退，单实例可用）
# REDIS_URL=redis://localhost:6379/0

# BIM 上传限额（MB）；解析已后台化，大模型不占请求时长
BIM_MAX_UPLOAD_MB=200
