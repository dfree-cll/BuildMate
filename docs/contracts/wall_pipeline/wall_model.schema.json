    "ModelingStandardConfig": {
      "additionalProperties": false,
      "description": "Executable project profile for Chinese national BIM standards.\n\nGB/T documents describe a common information and delivery framework; they\ndo not provide a drop-in wall-recognition algorithm.  This profile keeps\nthe normative references explicit and turns the parts that can be checked\ndeterministically (units, coordinates, classification, provenance and\nconstruction metadata) into pipeline gates.",
      "properties": {
        "profile": {
          "const": "cn_gb_bim_delivery_v1",
          "default": "cn_gb_bim_delivery_v1",
          "title": "Profile",
          "type": "string"
        },
        "references": {
          "items": {
            "type": "string"
          },
          "minItems": 3,
          "title": "References",
          "type": "array"
        },
        "units": {
          "const": "m",
          "default": "m",
          "title": "Units",
          "type": "string"
        },
        "delivery_units": {
          "const": "mm",
          "default": "mm",
          "title": "Delivery Units",
          "type": "string"
        },
        "coordinate_frame": {
          "default": "project_north",
          "enum": [
            "project_north",
            "true_north"
          ],
          "title": "Coordinate Frame",
          "type": "string"
        },
        "classification_system": {
          "const": "GB/T 51269-2017",
          "default": "GB/T 51269-2017",
          "title": "Classification System",
          "type": "string"
        },
        "application_standard": {
          "const": "GB/T 51212-2016",
          "default": "GB/T 51212-2016",
          "title": "Application Standard",
          "type": "string"
        },
        "delivery_standard": {
          "const": "GB/T 51301-2018",
          "default": "GB/T 51301-2018",
          "title": "Delivery Standard",
          "type": "string"
        },
        "construction_standard": {
          "anyOf": [
            {
              "const": "GB/T 51235-2017",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "GB/T 51235-2017",
          "title": "Construction Standard"
        },
        "naming_prefix": {
          "default": "BM",
          "maxLength": 16,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Naming Prefix",
          "type": "string"
        },
        "wall_type_prefix": {
          "default": "BM-WALL",
          "maxLength": 32,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Wall Type Prefix",
          "type": "string"
        },
        "column_type_prefix": {
          "default": "BM-COLUMN",
          "maxLength": 32,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Column Type Prefix",
          "type": "string"
        },
        "require_source_refs": {
          "default": true,
          "title": "Require Source Refs",
          "type": "boolean"
        },
        "require_classification_code": {
          "default": true,
          "title": "Require Classification Code",
          "type": "boolean"
        },
        "require_instance_parameters": {
          "default": true,
          "title": "Require Instance Parameters",
          "type": "boolean"
        },
        "require_level": {
          "default": true,
          "title": "Require Level",
          "type": "boolean"
        },
        "require_material": {
          "default": false,
          "title": "Require Material",
          "type": "boolean"
        },
        "require_quantities": {
          "default": true,
          "title": "Require Quantities",
          "type": "boolean"
        }
      },
      "title": "ModelingStandardConfig",
      "type": "object"
    },
