{
  "$defs": {
    "ApprovalRecord": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "approved",
            "rejected"
          ],
          "title": "Status",
          "type": "string"
        },
        "actor_id": {
          "minLength": 1,
          "title": "Actor Id",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "decided_at": {
          "format": "date-time",
          "title": "Decided At",
          "type": "string"
        }
      },
      "required": [
        "status",
        "actor_id",
        "reason"
      ],
      "title": "ApprovalRecord",
      "type": "object"
    },
    "BeamRecord": {
      "additionalProperties": false,
      "description": "A source-traceable coupling-beam centerline in metres.",
      "properties": {
        "beam_id": {
          "title": "Beam Id",
          "type": "string"
        },
        "start_m": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Start M",
          "type": "array"
        },
        "end_m": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "End M",
          "type": "array"
        },
        "width_m": {
          "exclusiveMinimum": 0,
          "title": "Width M",
          "type": "number"
        },
        "depth_m": {
          "exclusiveMinimum": 0,
          "title": "Depth M",
          "type": "number"
        },
        "level_id": {
          "title": "Level Id",
          "type": "string"
        },
        "source_refs": {
          "items": {
            "$ref": "#/$defs/EvidenceSourceRef"
          },
          "minItems": 1,
          "title": "Source Refs",
          "type": "array"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "type_mark": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Type Mark"
        },
        "construction": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConstructionInfo"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "quantities": {
          "anyOf": [
            {
              "$ref": "#/$defs/QuantityTakeoff"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "top_elevation_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Top Elevation M"
        },
        "base_elevation_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Base Elevation M"
        },
        "elevation_status": {
          "default": "unresolved",
          "enum": [
            "resolved",
            "level_default",
            "unresolved",
            "conflict"
          ],
          "title": "Elevation Status",
          "type": "string"
        },
        "elevation_source": {
          "default": "none",
          "enum": [
            "drawing",
            "schedule",
            "detail",
            "annotation",
            "level_default",
            "none"
          ],
          "title": "Elevation Source",
          "type": "string"
        },
        "elevation_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Elevation Text"
        },
        "elevation_refs": {
          "items": {
            "$ref": "#/$defs/EvidenceSourceRef"
          },
          "title": "Elevation Refs",
          "type": "array"
        }
      },
      "required": [
        "beam_id",
        "start_m",
        "end_m",
        "width_m",
        "depth_m",
        "level_id",
        "source_refs",
        "confidence"
      ],
      "title": "BeamRecord",
      "type": "object"
    },
    "ColumnRecord": {
      "additionalProperties": false,
