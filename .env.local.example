# BuildMate 环境配置（本地私有配置模板，勿提交 Git）
# 复制为 .env.local 后填写

# ── LLM（DeepSeek 官方）──
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.1

# ── 嵌入（留空=本地 BGE-M3 离线嵌入；填 key=API 嵌入）──
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3

# ── 数据库（默认 SQLite；生产切 PostgreSQL 改这里）──
DATABASE_URL=sqlite+aiosqlite:///./buildmate.db
# DATABASE_URL=postgresql+asyncpg://eduagent_user:eduagent123456@localhost:5433/buildmate

# ── Milvus 向量库（可选：Docker 启动后启用）──
MILVUS_HOST=
MILVUS_PORT=19531

# ── 本地模型路径（BGE-M3 / Reranker / MiniLM）──
MODELS_ROOT=models  # 或指向本地模型目录

# ── JWT ──
JWT_SECRET=CHANGE_ME_STRONG_RANDOM_AT_LEAST_32_CHARS
JWT_EXPIRE_MINUTES=1440

# ── 应用 ──
APP_ENV=prod
LOG_LEVEL=INFO
